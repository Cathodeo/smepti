' Gambas class file

Public Struct BattleState
  UIMode As Integer
  Turn As Integer
  IsFinish As Boolean
  SelfWin As Boolean
  LastEnemySpell As Integer
  
End Struct

Public Struct BChara
  DBID As Integer
  HP As Integer
  Buffs[4] As Integer
  Status As Integer
  CopiedSpells[2] As Integer
  CopyFactor[2] As Integer
End Struct



Public Hand[4] As Integer
Public State As BattleState
Public SelfBattler As BChara
Public FoeBattler As BChara
Private $FoeID As Integer


Public Sub SetFoe(ID As Integer)

  $FoeID = ID

End

Public Function GetFoe() As Integer
  
  Return $FoeID
  
End


Public Sub InitSelf(ident As Integer)

  SelfBattler = New BChara
  SelfBattler.DBID = ident
  SelfBattler.HP = 100
  SelfBattler.Status = 0


End


Public Sub InitFoe(ident As Integer)
  
  FoeBattler = New BChara
  FoeBattler.DBID = ident
  FoeBattler.HP = 100
  FoeBattler.Status = 0



End

Public Sub Shuffle(Bchara As BChara)

  Dim i As Integer
  Dim choice As Integer

  For i = 0 To 3

    If Bchara.CopiedSpells[0] = 0 Then

      ' Solo Copycat
      Hand[i] = 101

    Else If Bchara.CopiedSpells[1] = 0 Then

      ' Copycat + un spell
      choice = Rand(1, 2)

      If choice = 1 Then
        Hand[i] = 101
      Else
        Hand[i] = Bchara.CopiedSpells[0]
      Endif

    Else

      ' Copycat + dos spells
      choice = Rand(1, 3)

      If choice = 1 Then
        Hand[i] = 101
      Else If choice = 2 Then
        Hand[i] = Bchara.CopiedSpells[0]
      Else
        Hand[i] = Bchara.CopiedSpells[1]
      Endif

    Endif

  Next

End

  Public Function InitBattle()
  
  State = New BattleState
  InitSelf(1)
  InitFoe(2)
  State.Turn = 1
  State.LastEnemySpell = 0
  State.UIMode = 1
  State.IsFinish = False
  State.SelfWin = False
End


Public Function CalculateDmg(attacker As BChara, target As BChara, moveid As Integer) As Integer
  

  Dim Damage As Integer
  Dim SpellPower As Integer
  Dim DefenderDefense As Integer
  Dim AttackerPower As Integer

  
  SpellPower = MainDB.GetSpell(moveid).Power
  AttackerPower = MainDB.GetChara(attacker).Power
  DefenderDefense = MainDB.GetChara(target).Defense

  
  Damage = SpellPower + AttackerPower - DefenderDefense
  Return Damage
End


  
  


